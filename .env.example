TZ=Asia/Shanghai
ARGO_DOMAIN=nezha.example.com
# 二选一：Cloudflare Tunnel token 或 JSON 凭据
ARGO_TOKEN=
ARGO_AUTH=

# GitHub 私有备份仓库
GH_REPO=your-user/nezha-backup
GH_PAT=ghp_xxxxxxxxxxxxxxxxxxxx
GH_BRANCH=main
BACKUP_RETENTION=7

# 先在 V2 面板“添加服务器”生成本机服务器，再填入该用户的 NZ_CLIENT_SECRET
LOCAL_AGENT_ENABLED=true
LOCAL_AGENT_SECRET=
LOCAL_AGENT_SERVER=
LOCAL_AGENT_TLS=true

# 可选：用于每天拉取本项目脚本的 GitHub 仓库
SELF_UPDATE_REPO=
SELF_UPDATE_BRANCH=main
SELF_UPDATE_TOKEN=
